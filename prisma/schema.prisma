enum BildirimPlanModu {
  VARSAYILAN
  OZEL
  KAPALI
}

enum BildirimEntityType {
  VEKALET_TAKSITI
  RANDEVU
}

enum BildirimPlanKaynagi {
  VARSAYILAN
  OZEL
}

/// Tenant WhatsApp hesap durumu. Eski değerler migration uyumu için korunur.
enum WhatsAppBaglantiDurumu {
  BAGLI_DEGIL
  ONAY_BEKLIYOR
  BAGLI
  HATA
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
  BAGLANIYOR
  BAGLANTI_KESILDI
}

/// Tenant bazlı otomatik tahsilat bildirim ayarları. Varsayılan: kapalı + test modu.
model TahsilatBildirimAyar {
  id                    String   @id @default(uuid())
  tenantId              String   @unique @map("tenant_id")
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Büro otomasyonu genel anahtar. Varsayılan kapalı.
  otomasyonAktif        Boolean  @default(false) @map("otomasyon_aktif")
  /// Faz 1: gerçek gönderim yok; simülasyon. Meta onayı sonrası Faz 2'de kapatılabilir.
  testModu              Boolean  @default(true) @map("test_modu")
  /// Europe/Istanbul saat diliminde izin verilen gönderim penceresi (dakika 0–1439).
  izinliSaatBaslangic   Int      @default(600) @map("izinli_saat_baslangic")
  izinliSaatBitis       Int      @default(1200) @map("izinli_saat_bitis")
  /// @deprecated SMS otomatik gönderim kapalı; kolon geçmiş uyumluluk için tutulur.
  otomatikSmsAktif      Boolean  @default(false) @map("otomatik_sms_aktif")
  /// @deprecated SMS bakiye eşiği kullanılmaz.
  dusukSmsBakiyeEsigi   Int      @default(100) @map("dusuk_sms_bakiye_esigi")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("tahsilat_bildirim_ayar")
}

model TahsilatBildirimKurali {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kuralTuru       BildirimKuralTuru @map("kural_turu")
  aktifMi         Boolean           @default(false) @map("aktif_mi")
  /// VADEDEN_ONCE / VADE_SONRASI için gün sayısı; VADE_GUNU için 0.
  gunOffset       Int               @map("gun_offset")
  /// Gönderim saati (Europe/Istanbul), dakika cinsinden. Varsayılan 10:00 = 600.
  gonderimSaatiDk Int               @default(600) @map("gonderim_saati_dk")
  kanal           BildirimKanali    @default(WHATSAPP)
  /// Onaylı Meta şablon seçimi (otomasyon).
  metaSablonId    String?           @map("meta_sablon_id")
  metaSablon      WhatsAppMetaSablon? @relation(fields: [metaSablonId], references: [id], onDelete: SetNull)
  /// Katalog önerisi / seçilen libraryKey.
  libraryKey      String?           @map("library_key")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, kuralTuru, kanal])
  @@index([tenantId, aktifMi])
  @@index([metaSablonId])
  @@map("tahsilat_bildirim_kurali")
}

model TahsilatBildirimSablonu {
  id         String            @id @default(uuid())
  tenantId   String            @map("tenant_id")
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kuralTuru  BildirimKuralTuru @map("kural_turu")
  kanal      BildirimKanali    @default(WHATSAPP)
  /// Yerel önizleme şablonu (Meta şablonu değil). Değişkenler: {muvekkilAdi} vb.
  metin      String
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, kuralTuru, kanal])
  @@map("tahsilat_bildirim_sablonu")
}

model TahsilatBildirimIsi {
  id                 String           @id @default(uuid())
  tenantId           String           @map("tenant_id")
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  muvekkilId         String           @map("muvekkil_id")
  muvekkil           Muvekkil         @relation(fields: [muvekkilId], references: [id], onDelete: Cascade)
  dosyaId            String           @map("dosya_id")
  dosya              Dosya            @relation(fields: [dosyaId], references: [id], onDelete: Cascade)
  taksitId           String           @map("taksit_id")
  taksit             VekaletTaksiti   @relation(fields: [taksitId], references: [id], onDelete: Cascade)
  kanal              BildirimKanali   @default(WHATSAPP)
  /// MANUAL_WHATSAPP | WHATSAPP_CLOUD_API — eski SMS satırlarında null olabilir.
  provider           BildirimProvider? @map("provider")
  kuralTuru          BildirimKuralTuru @map("kural_turu")
  planlananAt        DateTime         @map("planlanan_at")
  /// Planlama anındaki kalan tutar anlık görüntüsü (gönderilmiş işlerde korunur).
  kalanTutarSnapshot Decimal          @db.Decimal(14, 2) @map("kalan_tutar_snapshot")
  durum              BildirimIsDurumu @default(PLANLANDI)
  iptalNedeni        String?          @map("iptal_nedeni")
  atlamaNedeni       String?          @map("atlama_nedeni")
  hataOzeti          String?          @map("hata_ozeti")
  denemeSayisi       Int              @default(0) @map("deneme_sayisi")
  sonDenemeAt        DateTime?        @map("son_deneme_at")
  /// @deprecated SMS alanları — geçmiş kayıtlar için korunur.
  smsParcaSayisi     Int?             @map("sms_parca_sayisi")
  smsKrediTuketimi   Int?             @map("sms_kredi_tuketimi")
  telefonMaskeli     String?          @map("telefon_maskeli")
  providerAdi        String?          @map("provider_adi")
  providerMessageId  String?          @map("provider_message_id")
  providerBulkId     String?          @map("provider_bulk_id")
  sonProviderHataKodu String?         @map("son_provider_hata_kodu")
  raporSonrakiSorguAt DateTime?       @map("rapor_sonraki_sorgu_at")
  raporSorguDeneme   Int              @default(0) @map("rapor_sorgu_deneme")
  manuelTetikleme    Boolean          @default(false) @map("manuel_tetikleme")
  /// tenant|taksit|kural|kanal|planYmd|kaynak|versiyon — DB unique mükerrerlik
  idempotencyKey     String           @unique @map("idempotency_key")
  /// VARSAYILAN tenant kuralı veya OZEL taksit planı.
  planKaynagi        BildirimPlanKaynagi @default(VARSAYILAN) @map("plan_kaynagi")
  planVersion        Int              @default(1) @map("plan_version")
  lockedAt           DateTime?        @map("locked_at")
  lockedBy           String?          @map("locked_by")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  denemeler          TahsilatBildirimDeneme[]
  smsKrediHareketleri SmsKrediHareketi[]

  @@index([tenantId, durum, planlananAt])
  @@index([tenantId, taksitId, durum])
  @@index([durum, planlananAt])
  @@map("tahsilat_bildirim_isi")
}

model TahsilatBildirimDeneme {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isId            String   @map("is_id")
  is              TahsilatBildirimIsi @relation(fields: [isId], references: [id], onDelete: Cascade)
  /// MOCK_SIMULATION | META_DISABLED | ...
  provider        String
  basariliMi      Boolean  @map("basarili_mi")
  /// Maskelenmiş telefon (tam numara saklanmaz).
  telefonMaskeli  String?  @map("telefon_maskeli")
  sablonOzeti     String?  @map("sablon_ozeti")
  mesajOzeti      String?  @map("mesaj_ozeti")
  sonucKodu       String?  @map("sonuc_kodu")
  sonucMesaji     String?  @map("sonuc_mesaji")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([isId, createdAt])
  @@map("tahsilat_bildirim_deneme")
}

/// Entity bazlı bildirim plan modu (taksit / randevu).
model BildirimPlanEntity {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType   BildirimEntityType @map("entity_type")
  entityId     String             @map("entity_id")
  mode         BildirimPlanModu   @default(VARSAYILAN)
  kanal        BildirimKanali     @default(WHATSAPP)
  /// Override değişince artırılır; idempotency ve replan için.
  planVersion  Int                @default(1) @map("plan_version")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  kurallar     BildirimPlanKural[]

  @@unique([tenantId, entityType, entityId, kanal])
  @@index([tenantId, entityType])
  @@map("bildirim_plan_entity")
}

/// Özel plan kuralları (mode=OZEL).
model BildirimPlanKural {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planEntityId    String             @map("plan_entity_id")
  planEntity      BildirimPlanEntity @relation(fields: [planEntityId], references: [id], onDelete: Cascade)
  /// VEKALET_TAKSITI: VADEDEN_ONCE | VADE_GUNU | VADE_SONRASI. RANDEVU: OFFSET_30 | OFFSET_60 | OFFSET_120 | OFFSET_1440 | CUSTOM
  ruleKey         String             @map("rule_key")
  aktifMi         Boolean            @default(true) @map("aktif_mi")
  /// Taksit: gün offset. Randevu CUSTOM: birim sayısı.
  gunOffset       Int                @default(0) @map("gun_offset")
  /// Randevu: dakika önce (30, 60, 120, 1440 veya custom).
  offsetDk        Int?               @map("offset_dk")
  /// Taksit: gönderim saati dk. Randevu: kullanılmaz (offsetDk ile hesaplanır).
  gonderimSaatiDk Int                @default(600) @map("gonderim_saati_dk")
  metaSablonId    String?            @map("meta_sablon_id")
  metaSablon      WhatsAppMetaSablon? @relation(fields: [metaSablonId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@unique([planEntityId, ruleKey])
  @@index([tenantId])
  @@map("bildirim_plan_kural")
}

/// Büro genel randevu WhatsApp hatırlatma ayarı.
model RandevuBildirimAyar {
  tenantId       String   @id @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  otomasyonAktif Boolean  @default(false) @map("otomasyon_aktif")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("randevu_bildirim_ayar")
}

/// Büro varsayılan randevu hatırlatma offsetleri.
model RandevuBildirimVarsayilanKural {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offsetDk     Int      @map("offset_dk")
  aktifMi      Boolean  @default(false) @map("aktif_mi")
  metaSablonId String?  @map("meta_sablon_id")
  metaSablon   WhatsAppMetaSablon? @relation(fields: [metaSablonId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, offsetDk])
  @@map("randevu_bildirim_varsayilan_kural")
}

/// Randevu WhatsApp hatırlatma iş kuyruğu.
model RandevuBildirimIsi {
  id                String              @id @default(uuid())
  tenantId          String              @map("tenant_id")
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  randevuId         String              @map("randevu_id")
  randevu           Randevu             @relation(fields: [randevuId], references: [id], onDelete: Cascade)
  muvekkilId        String              @map("muvekkil_id")
  muvekkil          Muvekkil            @relation(fields: [muvekkilId], references: [id], onDelete: Cascade)
  kanal             BildirimKanali      @default(WHATSAPP)
  provider          BildirimProvider?   @map("provider")
  offsetDk          Int                 @map("offset_dk")
  planlananAt       DateTime            @map("planlanan_at")
  durum             BildirimIsDurumu    @default(PLANLANDI)
  planKaynagi       BildirimPlanKaynagi @default(VARSAYILAN) @map("plan_kaynagi")
  planVersion       Int                 @default(1) @map("plan_version")
  iptalNedeni       String?             @map("iptal_nedeni")
  atlamaNedeni      String?             @map("atlama_nedeni")
  hataOzeti         String?             @map("hata_ozeti")
  denemeSayisi      Int                 @default(0) @map("deneme_sayisi")
  telefonMaskeli    String?             @map("telefon_maskeli")
  providerMessageId String?             @map("provider_message_id")
  metaSablonId      String?             @map("meta_sablon_id")
  idempotencyKey    String              @unique @map("idempotency_key")
  lockedAt          DateTime?           @map("locked_at")
  lockedBy          String?             @map("locked_by")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([tenantId, durum, planlananAt])
  @@index([tenantId, randevuId, durum])
  @@map("randevu_bildirim_isi")
}

enum SmsKrediHareketTuru {
  MANUEL_YUKLEME
  REZERVE
  TUKETIM
  REZERV_IPTALI
  IADE
  DUZELTME
}

model SmsTenantBakiye {
  id                String   @id @default(uuid())
  tenantId          String   @unique @map("tenant_id")
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mevcutBakiye      Int      @default(0) @map("mevcut_bakiye")
  toplamYuklenen    Int      @default(0) @map("toplam_yuklenen")
  toplamTuketilen   Int      @default(0) @map("toplam_tuketilen")
  toplamIadeEdilen  Int      @default(0) @map("toplam_iade_edilen")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("sms_tenant_bakiye")
}

model SmsKrediHareketi {
  id                 String            @id @default(uuid())
  tenantId           String            @map("tenant_id")
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bildirimIsiId      String?           @map("bildirim_isi_id")
  bildirimIsi        TahsilatBildirimIsi? @relation(fields: [bildirimIsiId], references: [id], onDelete: SetNull)
  tur                SmsKrediHareketTuru @map("tur")
  miktar             Int               @map("miktar")
  oncekiBakiye       Int               @map("onceki_bakiye")
  sonrakiBakiye      Int               @map("sonraki_bakiye")
  idempotencyKey     String            @map("idempotency_key")
  aciklama           String?           @map("aciklama")
  olusturanUserId    String?           @map("olusturan_user_id")
  olusturanAdminId   String?           @map("olusturan_admin_id")
  createdAt          DateTime          @default(now()) @map("created_at")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([bildirimIsiId])
  @@map("sms_kredi_hareketi")
}

/// Tenant WhatsApp bağlantı durumu. Cloud API token’ları yalnızca şifreli saklanır; frontend’e gitmez.
model WhatsAppBaglanti {
  id                       String                 @id @default(uuid())
  tenantId                 String                 @unique @map("tenant_id")
  tenant                   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  durum                    WhatsAppBaglantiDurumu @default(DISABLED)
  /// META_CLOUD — tek WhatsApp Cloud API yolu (paralel ikinci sistem yok).
  provider                 String                 @default("META_CLOUD")
  /// Yalnızca şifrelenmiş değer. Düz metin token kabul edilmez / loglanmaz.
  accessTokenEncrypted     String?                @map("access_token_encrypted")
  /// Routing için düz (maskesiz) WABA id.
  wabaId                   String?                @map("waba_id")
  /// Routing için düz (maskesiz) phone_number_id.
  phoneNumberId            String?                @map("phone_number_id")
  wabaIdMasked             String?                @map("waba_id_masked")
  phoneNumberIdMasked      String?                @map("phone_number_id_masked")
  displayPhoneNumber       String?                @map("display_phone_number")
  verifiedName             String?                @map("verified_name")
  businessAccountName      String?                @map("business_account_name")
  tokenExpiresAt           DateTime?              @map("token_expires_at")
  webhookOverrideActive    Boolean                @default(false) @map("webhook_override_active")
  webhookOverrideCallback  String?                @map("webhook_override_callback")
  connectedAt              DateTime?              @map("connected_at")
  disconnectedAt           DateTime?              @map("disconnected_at")
  lastWebhookAt            DateTime?              @map("last_webhook_at")
  sonHataOzeti             String?                @map("son_hata_ozeti")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  webhookEvents            WhatsAppWebhookEvent[]
  gelenMesajlar            WhatsAppGelenMesaj[]
  metaSablonlar            WhatsAppMetaSablon[]

  /// Postgres UNIQUE birden fazla NULL’a izin verir.
  @@unique([phoneNumberId])
  @@index([phoneNumberId])
  @@index([wabaId])
  @@map("whatsapp_baglanti")
}

/// Meta webhook olayları — idempotency (metaEventId unique).
model WhatsAppWebhookEvent {
  id                String            @id @default(uuid())
  tenantId          String?           @map("tenant_id")
  tenant            Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  baglantiId        String?           @map("baglanti_id")
  baglanti          WhatsAppBaglanti? @relation(fields: [baglantiId], references: [id], onDelete: SetNull)
  metaEventId       String            @unique @map("meta_event_id")
  phoneNumberId     String?           @map("phone_number_id")
  wabaId            String?           @map("waba_id")
  eventType         String            @map("event_type")
  statusRaw         String?           @map("status_raw")
  providerMessageId String?           @map("provider_message_id")
  processedOk       Boolean           @default(false) @map("processed_ok")
  errorCode         String?           @map("error_code")
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([phoneNumberId])
  @@map("whatsapp_webhook_event")
}

/// Gelen WhatsApp mesajları — yalnızca metadata (içerik saklanmaz).
model WhatsAppGelenMesaj {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baglantiId     String           @map("baglanti_id")
  baglanti       WhatsAppBaglanti @relation(fields: [baglantiId], references: [id], onDelete: Cascade)
  metaMessageId  String           @unique @map("meta_message_id")
  messageType    String           @map("message_type")
  senderMasked   String           @map("sender_masked")
  receivedAt     DateTime         @map("received_at")
  processedDurum String           @default("ALINDI") @map("processed_durum")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([baglantiId])
  @@map("whatsapp_gelen_mesaj")
}

/// Meta Cloud API message template senkron kaydı.
model WhatsAppMetaSablon {
  id               String            @id @default(uuid())
  tenantId         String            @map("tenant_id")
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baglantiId       String?           @map("baglanti_id")
  baglanti         WhatsAppBaglanti? @relation(fields: [baglantiId], references: [id], onDelete: SetNull)
  metaName         String            @map("meta_name")
  language         String
  /// BEKLIYOR | ONAYLANDI | REDDEDILDI | DURAKLATILDI | DEVRE_DISI | GONDERILIYOR
  statusNormalized String            @map("status_normalized")
  category         String?
  /// Hazır kütüphane anahtarı (global katalog).
  libraryKey       String?           @map("library_key")
  /// Submit anındaki WABA id (tenant isolation + duplicate koruması).
  providerWabaId   String?           @map("provider_waba_id")
  metaTemplateId   String?           @map("meta_template_id")
  rejectionReason  String?           @map("rejection_reason")
  componentsSnapshot Json?           @map("components_snapshot")
  parameterFormat  String?           @map("parameter_format")
  submittedAt      DateTime?         @map("submitted_at")
  approvedAt       DateTime?         @map("approved_at")
  lastSyncedAt     DateTime          @map("last_synced_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  kurallar         TahsilatBildirimKurali[]
  bildirimPlanKurallari BildirimPlanKural[]
  randevuBildirimVarsayilanKurallari RandevuBildirimVarsayilanKural[]

  @@unique([tenantId, metaName, language])
  @@index([tenantId])
  @@index([baglantiId])
  @@index([libraryKey])
  @@index([providerWabaId])
  @@map("whatsapp_meta_sablon")
}

/// Woontegra platform yöneticisi (büro kullanıcısı değildir).
enum SuperAdminRole {
  SUPER_ADMIN
  DESTEK
  FINANS
}

model SuperAdmin {
  id             String          @id @default(uuid())
  adSoyad        String          @map("ad_soyad")
  kullaniciAdi   String          @unique @map("kullanici_adi")
  eposta         String?         @unique @map("eposta")
  sifreHash      String          @map("sifre_hash")
  rol            SuperAdminRole
  aktifMi        Boolean         @default(true) @map("aktif_mi")
  sonGirisTarihi DateTime?       @map("son_giris_tarihi")
  /// Tenant User ile güvenli bağlantı — e-posta eşleşmesi yetki vermez.
  linkedUserId   String?         @unique @map("linked_user_id")
  linkedUser     User?           @relation("SuperAdminLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  adminAuditLogs   AdminAuditLog[]
  refreshSessions  AdminRefreshSession[]

  @@map("super_admin")
}

/// Woontegra admin işlem kaydı (kiracı audit_log’dan ayrı).
model AdminAuditLog {
  id         String      @id @default(uuid())
  adminId    String?     @map("admin_id")
  admin      SuperAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  entityType String?     @map("entity_type")
  entityId   String?     @map("entity_id")
  oldValue   Json?       @map("old_value")
  newValue   Json?       @map("new_value")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
  @@map("admin_audit_log")
}
