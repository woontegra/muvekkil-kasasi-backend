  SMS
  WHATSAPP
}

/// Gönderim sağlayıcısı — channel'dan ayrı.
enum BildirimProvider {
  MANUAL_WHATSAPP
  WHATSAPP_CLOUD_API
}

enum BildirimKuralTuru {
  VADEDEN_ONCE
  VADE_GUNU
  VADE_SONRASI
}

enum BildirimIsDurumu {
  PLANLANDI
  KUYRUKTA
  SIMULASYON_TAMAMLANDI
  GONDERILDI
  TESLIM_EDILDI
  OKUNDU
  BASARISIZ
  IPTAL_EDILDI
  ATLANDI
}

/// Tenant WhatsApp hesap durumu. Eski değerler migration uyumu için korunur.
