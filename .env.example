# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/muvekkil_kasa_saas?schema=public"

# API
PORT=4000
NODE_ENV=development

# JWT (örnek: güçlü rastgele secret kullanın; en az 16 karakter)
JWT_SECRET="change-me-to-a-long-random-string-at-least-16"
JWT_EXPIRES_IN="8h"

# CORS: Vite dev sunucusu
CORS_ORIGIN="http://localhost:5173"

# Şifre sıfırlama e-postasındaki frontend link kökü (öncelik: RESET_PASSWORD_URL > FRONTEND_URL > PUBLIC_APP_URL > CORS_ORIGIN)
# FRONTEND_URL="http://localhost:5173"
# PUBLIC_APP_URL="http://localhost:5173"

# Gmail SMTP kolay kurulum (SMTP_* tanımlı değilse kullanılır)
# GMAIL_USER=info@woontegra.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_FROM="Müvekkil Kasa Defteri <info@woontegra.com>"
# FRONTEND_URL=http://localhost:5173

# Genel SMTP (SMTP_HOST + SMTP_USER + SMTP_PASS tanımlıysa Gmail'den önce kullanılır)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="noreply@example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="Müvekkil Kasa <noreply@example.com>"
# MAIL_FROM="noreply@example.com"
# SMTP_SECURE=false

# Woontegra süper admin JWT (tanımlı değilse JWT_SECRET kullanılır; admin token payload `typ: admin`)
# ADMIN_JWT_SECRET="ayri-guclu-secret-min-16"
# ADMIN_JWT_EXPIRES_IN="8h"

# İlk süper admin: npm run seed:admin
# ADMIN_SEED_USERNAME=admin
# ADMIN_SEED_EMAIL=admin@woontegra.com
# ADMIN_SEED_PASSWORD="GüçlüBirŞifre"
# ADMIN_SEED_AD_SOYAD="Woontegra Yönetici"
# ADMIN_SEED_ROLE=SUPER_ADMIN

# Tek platform sahibi bootstrap (parolayı asla commit etmeyin; yalnızca runtime env):
# ADMIN_BOOTSTRAP_EMAIL=info@example.com
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_AD_SOYAD="Woontegra Süper Admin"
# ADMIN_BOOTSTRAP_USERNAME=
# Railway/production yazımı için: ADMIN_BOOTSTRAP_CONFIRM_PRODUCTION=YES

# Woontegra Website ödeme sonrası Müvekkil Kasa SaaS tenant/büro oluşturma entegrasyonu (server-to-server secret)
# WOONTEGRA_WEBSITE_PROVISION_SECRET=""

# ACTIVATION_TOKEN_EXPIRES_HOURS=72

# WhatsApp Cloud API (Meta) — production secret’ları asla commit etmeyin
# WHATSAPP_CLOUD_API_ENABLED=false
# WHATSAPP_GRAPH_API_VERSION=v22.0
# WHATSAPP_APP_ID=
# META_APP_ID=   # alias; WHATSAPP_APP_ID tercih edilir
# WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# WHATSAPP_WEBHOOK_PUBLIC_URL=https://your-api.example/api/webhooks/whatsapp
# WHATSAPP_TOKEN_ENCRYPTION_KEY=   # min 32 karakter; production bağlantıda zorunlu
# Tenant gönderimi WhatsAppBaglanti üzerinden; aşağıdakiler yalnızca opsiyonel platform smoke:
# WHATSAPP_WABA_ID=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# Yalnızca bağlantı testi: npm run whatsapp:cloud-test
# WHATSAPP_CLOUD_TEST_PHONE=
# WHATSAPP_CLOUD_TEST_TEMPLATE_NAME=hello_world
# WHATSAPP_CLOUD_TEST_TEMPLATE_LANG=en_US
# WHATSAPP_AUTOMATION_ENABLED=false
# WHATSAPP_WEBHOOK_ENABLED=false
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
